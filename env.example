# ── API Keys ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ── Telegram Bot ──────────────────────────────
# 1. Parla con @BotFather su Telegram → /newbot → copia il token
# 2. Aggiungi il bot al tuo canale/gruppo → usa @userinfobot per il chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ── WordPress (opzionale) ─────────────────────
# Vai su WP Admin → Utenti → Il tuo profilo → Application Passwords
# Crea una nuova password (es. "Agente Notizie") e copia il valore
WP_URL=https://tuosito.it
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Scheduler ────────────────────────────────
# Intervallo in minuti (default: 10)
INTERVAL_MINUTES=10
